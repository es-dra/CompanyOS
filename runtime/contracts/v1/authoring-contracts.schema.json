{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/contracts/v1/authoring-contracts.schema.json",
  "title": "CompanyOS Runtime Authoring Contract Bundle v1",
  "description": "Closed authoring envelopes accepted by the Goal Compiler. Contextual fields are retained for compilation warnings but never grant authority.",
  "oneOf": [
    { "$ref": "#/$defs/GoalAuthoringEnvelope" },
    { "$ref": "#/$defs/TaskAuthoringEnvelope" }
  ],
  "$defs": {
    "NonEmptyString": { "type": "string", "minLength": 1 },
    "StringList": { "type": "array", "items": { "type": "string" } },
    "RuntimeSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_key", "target_identity", "allowed_probes"],
      "properties": {
        "surface_key": { "$ref": "#/$defs/NonEmptyString" },
        "target_identity": { "$ref": "#/$defs/NonEmptyString" },
        "allowed_probes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "max_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "trigger_event_required": { "type": "boolean" }
      }
    },
    "OwnerAuthority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_scope": { "$ref": "#/$defs/StringList" },
        "write_scope": { "$ref": "#/$defs/StringList" },
        "forbidden_scope": { "$ref": "#/$defs/StringList" },
        "allowed_capabilities": { "$ref": "#/$defs/StringList" }
      }
    },
    "ProviderBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "max_minor_units": { "type": "integer", "minimum": 0 },
        "max_calls": { "type": "integer", "minimum": 0 }
      }
    },
    "CircuitBreakers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations_without_new_evidence": { "type": "integer", "minimum": 1 },
        "provider_budget": { "$ref": "#/$defs/ProviderBudget" }
      }
    },
    "GoalAuthoringPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "target_outcome", "success_evidence_states", "owner_authority"],
      "properties": {
        "goal_id": { "$ref": "#/$defs/NonEmptyString" },
        "source_request": { "type": ["string", "object", "array", "null"] },
        "target_outcome": { "$ref": "#/$defs/NonEmptyString" },
        "success_evidence_states": { "$ref": "#/$defs/StringList" },
        "non_goals": { "$ref": "#/$defs/StringList" },
        "owner_authority": { "$ref": "#/$defs/OwnerAuthority" },
        "required_runtime_surfaces": { "type": "array", "items": { "$ref": "#/$defs/RuntimeSurface" } },
        "context_pack": {},
        "project_adoption_ref": {},
        "evaluator_required": { "type": "boolean" },
        "integration_policy": {},
        "circuit_breakers": { "$ref": "#/$defs/CircuitBreakers" },
        "stop_routes": { "type": "array" },
        "closeout_shape": {}
      }
    },
    "GoalAuthoringEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_contract"],
      "properties": { "goal_contract": { "$ref": "#/$defs/GoalAuthoringPacket" } }
    },
    "Gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {},
        "external_download": {},
        "repo_remote": {},
        "server_write": {},
        "provider": {},
        "public_release": {},
        "destructive_operations": {}
      }
    },
    "WorkflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "adapter", "action", "resource", "request_digest"],
      "properties": {
        "step_id": { "$ref": "#/$defs/NonEmptyString" },
        "adapter": { "$ref": "#/$defs/NonEmptyString" },
        "action": { "$ref": "#/$defs/NonEmptyString" },
        "resource": { "$ref": "#/$defs/NonEmptyString" },
        "request_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "TaskAuthoringPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "parent_goal_id", "objective", "expected_delta", "primary_artifact_or_surface", "evidence_target"],
      "properties": {
        "task_id": { "$ref": "#/$defs/NonEmptyString" },
        "parent_goal_id": { "$ref": "#/$defs/NonEmptyString" },
        "objective": { "$ref": "#/$defs/NonEmptyString" },
        "expected_delta": { "$ref": "#/$defs/NonEmptyString" },
        "primary_artifact_or_surface": { "$ref": "#/$defs/NonEmptyString" },
        "read_scope": { "$ref": "#/$defs/StringList" },
        "write_scope": { "$ref": "#/$defs/StringList" },
        "forbidden_scope": { "$ref": "#/$defs/StringList" },
        "capabilities": { "$ref": "#/$defs/StringList" },
        "evaluator_policy": { "enum": ["not_required", "required_before_integration", "required_before_claim"] },
        "evaluator_required": { "type": "boolean" },
        "integration_required": { "type": "boolean" },
        "required_runtime_surfaces": { "type": "array", "items": { "$ref": "#/$defs/RuntimeSurface" } },
        "gates": { "$ref": "#/$defs/Gates" },
        "workflow_steps": { "type": "array", "items": { "$ref": "#/$defs/WorkflowStep" } },
        "evidence_target": { "$ref": "#/$defs/NonEmptyString" },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "dirty_boundary": {},
        "worktree_policy": {},
        "worker_policy": {},
        "procedure": {},
        "verification_route": {},
        "integration_route": {},
        "stop_conditions": {},
        "close_condition": {},
        "delete_or_retire_condition": {},
        "requirement_closure_map": {},
        "non_claims": {}
      }
    },
    "TaskAuthoringEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_packet"],
      "properties": { "task_packet": { "$ref": "#/$defs/TaskAuthoringPacket" } }
    }
  }
}
