{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/contracts/v1/authority-spine.schema.json",
  "title": "CompanyOS Project and Program Authority Spine v0.1",
  "oneOf": [
    { "$ref": "#/$defs/ProjectSpec" },
    { "$ref": "#/$defs/ProgramSpec" },
    { "$ref": "#/$defs/CompiledGoalAuthority" },
    { "$ref": "#/$defs/CompiledTaskAuthority" }
  ],
  "$defs": {
    "NonEmptyString": { "type": "string", "minLength": 1 },
    "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Scope": { "type": "string", "minLength": 1 },
    "Capability": {
      "enum": [
        "read_local", "write_local", "network", "external_download",
        "repo_remote", "server_read", "server_write", "provider_cost",
        "public_release", "destructive", "durable_memory_promotion",
        "active_rule_promotion", "control_resume"
      ]
    },
    "AuthorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "object_id", "version", "digest"],
      "properties": {
        "kind": { "enum": ["project", "program", "goal"] },
        "object_id": { "$ref": "#/$defs/NonEmptyString" },
        "version": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/Digest" }
      }
    },
    "RuntimeSurfaceSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_key", "target_identity", "allowed_probes"],
      "properties": {
        "surface_key": { "$ref": "#/$defs/NonEmptyString" },
        "target_identity": { "$ref": "#/$defs/NonEmptyString" },
        "allowed_probes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/NonEmptyString" }
        },
        "max_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "trigger_event_required": { "type": "boolean" }
      }
    },
    "AuthorityBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities", "read_scope", "write_scope", "forbidden_scope",
        "required_runtime_surfaces", "provider_budget_minor_units",
        "provider_call_limit", "budget_currency", "evaluator_required",
        "required_decision_gates"
      ],
      "properties": {
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Capability" } },
        "read_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Scope" } },
        "write_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Scope" } },
        "forbidden_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Scope" } },
        "required_runtime_surfaces": { "type": "array", "items": { "$ref": "#/$defs/RuntimeSurfaceSpec" } },
        "provider_budget_minor_units": { "type": "integer", "minimum": 0 },
        "provider_call_limit": { "type": "integer", "minimum": 0 },
        "budget_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "evaluator_required": { "type": "boolean" },
        "required_decision_gates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/NonEmptyString" } }
      }
    },
    "ProjectSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project_id", "version", "target_outcome", "authority"],
      "properties": {
        "schema_version": { "const": "companyos.project-spec.v1" },
        "project_id": { "$ref": "#/$defs/NonEmptyString" },
        "version": { "type": "integer", "minimum": 1 },
        "target_outcome": { "$ref": "#/$defs/NonEmptyString" },
        "authority": { "$ref": "#/$defs/AuthorityBounds" }
      }
    },
    "ProgramSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "program_id", "version", "project_ref", "objective",
        "state", "dependency_refs", "wave", "authority"
      ],
      "properties": {
        "schema_version": { "const": "companyos.program-spec.v1" },
        "program_id": { "$ref": "#/$defs/NonEmptyString" },
        "version": { "type": "integer", "minimum": 1 },
        "project_ref": { "$ref": "#/$defs/AuthorityRef" },
        "objective": { "$ref": "#/$defs/NonEmptyString" },
        "state": { "enum": ["compiled", "active", "delivered", "canceled", "retired"] },
        "dependency_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/AuthorityRef" } },
        "wave": { "type": "integer", "minimum": 0 },
        "authority": { "$ref": "#/$defs/AuthorityBounds" }
      }
    },
    "CompiledGoalAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "version", "project_ref", "program_ref", "required_decision_gates", "goal_spec"],
      "properties": {
        "schema_version": { "const": "companyos.compiled-goal-authority.v1" },
        "version": { "type": "integer", "minimum": 1 },
        "project_ref": { "$ref": "#/$defs/AuthorityRef" },
        "program_ref": { "$ref": "#/$defs/AuthorityRef" },
        "required_decision_gates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "goal_spec": { "$ref": "runtime-contracts.schema.json#/$defs/GoalSpec" }
      }
    },
    "CompiledTaskAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "version", "project_ref", "program_ref", "goal_ref", "required_decision_gates", "decision_gate_contracts",
        "provider_budget_minor_units", "provider_call_limit", "budget_currency", "task_spec"
      ],
      "properties": {
        "schema_version": { "const": "companyos.compiled-task-authority.v1" },
        "version": { "type": "integer", "minimum": 1 },
        "project_ref": { "$ref": "#/$defs/AuthorityRef" },
        "program_ref": { "$ref": "#/$defs/AuthorityRef" },
        "goal_ref": { "$ref": "#/$defs/AuthorityRef" },
        "required_decision_gates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "decision_gate_contracts": {
          "type": "array",
          "items": { "$ref": "#/$defs/DecisionGateContract" }
        },
        "provider_budget_minor_units": { "type": "integer", "minimum": 0 },
        "provider_call_limit": { "type": "integer", "minimum": 0 },
        "budget_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "task_spec": { "$ref": "runtime-contracts.schema.json#/$defs/TaskSpec" }
      }
    },
    "DecisionGateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "capability", "action", "resource", "request_digest"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/NonEmptyString" },
        "capability": { "enum": ["provider_cost", "repo_remote", "public_release"] },
        "action": { "$ref": "#/$defs/NonEmptyString" },
        "resource": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[^*]+$" },
        "request_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
